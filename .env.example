# ResolvOps ForexBot — environment template.
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# ---- AI brain (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- OANDA v20 credentials ----
# Create a token in your OANDA account: Manage API Access -> Generate.
OANDA_API_TOKEN=your-oanda-v20-api-token
OANDA_ACCOUNT_ID=000-000-00000000-000

# ---- Trading environment ----
# "practice" = OANDA demo money on the real market feed (default, safe).
# "live"     = real money. Requires I_UNDERSTAND_REAL_MONEY=YES as well.
OANDA_ENV=practice

# Second safety switch for live trading. Leave blank until you truly mean it.
# Set to exactly YES (with OANDA_ENV=live) to allow real-money orders.
I_UNDERSTAND_REAL_MONEY=
